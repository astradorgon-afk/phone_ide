<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled app-wide (android:allowBackup="false"). These rules exist so that if
  backup is ever enabled, secrets and credentials are excluded by construction rather than
  by remembering to. See SECURITY.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="database" path="mobileforge.db" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="database" path="mobileforge.db" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
