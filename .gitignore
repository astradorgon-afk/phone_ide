*.iml
.gradle/
.kotlin/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
hs_err_pid*.log
replay_pid*.log
*.apk
*.aab
.toolchain-src/
toolchain-output/
*-build.log
toolchain-*.log
device-verification.log
emulator-*.log
*.keystore
!debug.keystore

# Vendored third-party editor assets are fetched by tools/fetch-monaco.sh
/app/src/main/assets/monaco/

# Embedded toolchain bundles are build artifacts (tens of MB) staged from
# build/toolchain-bundles/ — never committed. The setup flow treats their absence
# as an honest empty state, not an error.
app/src/main/assets/bundles/*
!app/src/main/assets/bundles/.gitkeep

# The catalog is NOT a build artifact: it is the hand-maintained list of which
# bundles a release publishes, and the app reads it to install without asking the
# user to find files. It is small and must be versioned.
!app/src/main/assets/bundles/catalog.json

# Never commit real secrets
*.env
!.env.example
